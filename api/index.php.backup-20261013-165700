function syncStudentPublicProfiles(PDO $pdo, int $userId): void
{
    $stmt=$pdo->prepare("SELECT u.*,sp.*,c.title AS course_title FROM users u LEFT JOIN student_profiles sp ON sp.user_id=u.id LEFT JOIN courses c ON c.id=sp.course_id WHERE u.id=? AND u.role='student' LIMIT 1");
    $stmt->execute([$userId]);$row=$stmt->fetch();if(!$row)return;
    $slug='student-'.$userId.'-'.profileSlug((string)$row['name']);
    $image=(string)($row['image'] ?: ($row['avatar_url'] ?? ''));
    $course=(string)($row['course_title'] ?? '');

    $alumni=$pdo->prepare('SELECT id FROM alumni WHERE student_id=? LIMIT 1');$alumni->execute([$userId]);$alumniId=(int)($alumni->fetchColumn()?:0);
    if(!empty($row['is_alumni'])){
        $vals=[$slug,$row['name'],$image,$course,$row['alumni_role']??'',$row['alumni_company']??'',$row['alumni_salary']??'',$row['alumni_location']??'',$row['alumni_graduation_year']??'',$row['alumni_quote']??'','published'];
        if($alumniId){$q=$pdo->prepare('UPDATE alumni SET slug=?,name=?,image=?,course=?,role_title=?,company=?,salary=?,location=?,graduation_year=?,quote=?,status=? WHERE id=?');$q->execute([...$vals,$alumniId]);}
        else{$q=$pdo->prepare('INSERT INTO alumni (student_id,slug,name,image,course,role_title,company,salary,location,graduation_year,quote,status,sort_order) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,0)');$q->execute([$userId,...$vals]);}
    }elseif($alumniId){$pdo->prepare("UPDATE alumni SET status='draft' WHERE id=?")->execute([$alumniId]);}

    $candidate=$pdo->prepare('SELECT id FROM job_seekers WHERE student_id=? LIMIT 1');$candidate->execute([$userId]);$candidateId=(int)($candidate->fetchColumn()?:0);
    if(!empty($row['is_job_seeker'])){
        $skills=(string)($row['job_skills_json'] ?? '[]');
        $vals=[$slug,$row['name'],$image,$course,$skills,$row['job_experience']??'Fresher',$row['job_location']??'Hyderabad',$row['job_availability']??'Available',$row['email']??'',$row['phone']??'',$row['job_summary']??'','published'];
        if($candidateId){$q=$pdo->prepare('UPDATE job_seekers SET slug=?,name=?,image=?,course=?,skills_json=?,experience=?,location=?,availability=?,email=?,phone=?,summary=?,status=? WHERE id=?');$q->execute([...$vals,$candidateId]);}
        else{$q=$pdo->prepare('INSERT INTO job_seekers (student_id,slug,name,image,course,skills_json,experience,location,availability,email,phone,summary,status,sort_order) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,0)');$q->execute([$userId,...$vals]);}
    }elseif($candidateId){$pdo->prepare("UPDATE job_seekers SET status='draft' WHERE id=?")->execute([$candidateId]);}
}

