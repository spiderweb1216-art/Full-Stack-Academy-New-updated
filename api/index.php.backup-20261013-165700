    $zoom=zoomSettings($pdo);
    return [
        'topic'=>$title,
        'type'=>2,
        'start_time'=>$startsAt?str_replace(' ','T',$startsAt):date('Y-m-d\\TH:i:s'),
        'duration'=>$duration,
