function loginUser(PDO $pdo, array $data, ?string $requiredRole = null): never
{
    $identifier = clean($data['identifier'] ?? $data['email'] ?? '', 190);
    $password = (string)($data['password'] ?? '');
    $accountType = in_array($data['account_type'] ?? '', ['student','instructor'], true) ? $data['account_type'] : null;
    if ($identifier === '' || $password === '') {
        respond(['success' => false, 'message' => 'Enter your email or academy ID and password.'], 422);
    }

    $stmt = $pdo->prepare('SELECT * FROM users WHERE LOWER(email)=LOWER(?) OR UPPER(student_code)=UPPER(?) LIMIT 1');
    $stmt->execute([$identifier,$identifier]);
    $user = $stmt->fetch();
    $valid = $user && password_verify($password, (string)$user['password_hash']);
    $userRole = (string)($user['role'] ?? '');
    $adminRoleMatch = $requiredRole === 'admin' && in_array($userRole,['admin','super_admin','admin_staff','branch_head','branch_admin','instructor'],true);
    $roleMismatch = ($requiredRole !== null && !$adminRoleMatch && $userRole !== $requiredRole)
        || ($accountType !== null && $userRole !== $accountType);
    if (!$valid || $roleMismatch || (in_array($userRole,['admin','super_admin','admin_staff','branch_head','branch_admin'],true) && $requiredRole !== 'admin')) {
        usleep(300000);
        respond(['success' => false, 'message' => $requiredRole === 'admin' ? 'Administrator email or password is incorrect.' : 'Login details or selected profile type are incorrect.'], 401);
    }
    if (($user['status'] ?? '') !== 'active') {
        $message = ($user['status'] ?? '') === 'pending'
            ? 'Your instructor profile is awaiting administrator approval.'
            : 'This account is blocked.';
        respond(['success' => false, 'message' => $message], 403);
    }

    session_regenerate_id(true);
    if ($requiredRole === 'admin' || in_array(($user['role'] ?? ''),['admin','super_admin','admin_staff','branch_head','branch_admin'],true)) {
        // Keep the administrator login independent from learner/instructor logins.
        $_SESSION['admin_user_id'] = (int)$user['id'];
    } else {
        $roleKey = ($user['role'] ?? '') === 'instructor' ? 'instructor_user_id' : 'student_user_id';
        $_SESSION[$roleKey] = (int)$user['id'];
        // Retain the legacy key for older endpoints, but role-specific endpoints
        // use the dedicated session slots so Student and Instructor tabs can coexist.
        $_SESSION['user_id'] = (int)$user['id'];
        issueRememberToken($pdo, (int)$user['id']);
    }
    $pdo->prepare('UPDATE users SET last_login_at=NOW() WHERE id=?')->execute([$user['id']]);
    $user['last_login_at'] = nowSql();
    respond(['success' => true, 'message' => 'Signed in successfully.', 'user' => publicUser($user)]);
}

