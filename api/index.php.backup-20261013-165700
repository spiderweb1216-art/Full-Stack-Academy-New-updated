function normalizeFeaturedEvent(PDO $pdo): void
{
    // Keep at most one explicitly featured event. If older versions left multiple
    // featured rows behind, retain the newest dated one and clear the rest.
    $rows = $pdo->query("SELECT id FROM events WHERE featured=1 ORDER BY event_date DESC,id DESC")->fetchAll();
    if (count($rows) <= 1) return;
    $keepId = (int)$rows[0]['id'];
    $stmt = $pdo->prepare("UPDATE events SET featured=0 WHERE featured=1 AND id<>?");
    $stmt->execute([$keepId]);
}

