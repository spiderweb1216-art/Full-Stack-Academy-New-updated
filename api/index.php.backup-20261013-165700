function sendEmail(PDO $pdo, string $to, string $subject, string $body, string $type = 'transactional'): array
{
    $site = getSetting($pdo, 'site', []);
    $smtp = getSetting($pdo, 'smtp', []);
    if (empty($smtp['enabled'])) {
        logEmail($pdo, $to, $subject, $type, 'skipped', 'SMTP is disabled.');
        return ['success' => false, 'message' => 'SMTP is disabled.'];
    }
    $smtp['password'] = decryptSecret((string)($smtp['password_encrypted'] ?? ''), appKey());
    try {
        $result = (new SmtpMailer())->send($smtp, $to, $subject, emailShell($subject, $body, $site));
        logEmail($pdo, $to, $subject, $type, 'sent', $result['message']);
        return $result;
    } catch (Throwable $error) {
        logEmail($pdo, $to, $subject, $type, 'failed', $error->getMessage());
        return ['success' => false, 'message' => $error->getMessage()];
    }
}

function sendTemplate(PDO $pdo, string $key, string $to, array $variables): void
{
    $site = getSetting($pdo, 'site', []);
    if (empty($site['email_notifications'])) return;
    $template = getTemplate($pdo, $key);
    if (!$template || empty($template['enabled'])) return;
    sendEmail($pdo, $to, renderTemplate($template['subject'], $variables), renderTemplate($template['body'], $variables), $key);
}

