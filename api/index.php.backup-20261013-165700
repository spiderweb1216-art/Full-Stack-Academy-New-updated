function ensureDummyRecordedLectures(PDO $pdo): void
{
    // One-time test content only. Access remains governed by the existing
    // course assignment + student enrollment rules used everywhere else.
    $pdo->exec("CREATE TABLE IF NOT EXISTS app_seed_flags (seed_key VARCHAR(190) PRIMARY KEY, seeded_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
    $seedKey = 'fsa_youtube_recorded_lecture_demo_20261007_v1';
    $flag = $pdo->prepare('SELECT seed_key FROM app_seed_flags WHERE seed_key=? LIMIT 1');
    $flag->execute([$seedKey]);
    if ($flag->fetchColumn()) return;

    // Prefer the Business Analyst course used in the current test setup.
    // Importantly, only choose a course that is already assigned to a real
    // instructor. We do not create/alter course ownership or permissions.
    $course = $pdo->query("SELECT c.id,c.instructor_user_id,c.title
        FROM courses c
        JOIN users u ON u.id=c.instructor_user_id
        WHERE c.status='published'
          AND c.instructor_user_id IS NOT NULL
          AND c.instructor_user_id>0
          AND u.role='instructor'
        ORDER BY CASE WHEN LOWER(c.title) LIKE '%business analyst%' THEN 0 ELSE 1 END, c.id ASC
        LIMIT 1")->fetch();

    // If no course has been assigned to an instructor yet, do nothing and do
    // not set the flag. The seed can run automatically after assignment.
    if (!$course) return;

    $courseId = (int)$course['id'];
    $instructorId = (int)$course['instructor_user_id'];
    $maxStmt = $pdo->prepare('SELECT COALESCE(MAX(sort_order),0) FROM recorded_lectures WHERE course_id=?');
    $maxStmt->execute([$courseId]);
    $nextOrder = (int)$maxStmt->fetchColumn() + 1;

    $lectures = [
        [
            'Demo 01 — SQL Foundations',
            'Testing lecture: database and SQL foundations. This public YouTube lesson is included only so you can test the Recorded Lectures archive, sequence and player.',
            'https://www.youtube.com/watch?v=HXV3zeQKqGY',
            250,
        ],
        [
            'Demo 02 — SQL Practice & Interview Questions',
