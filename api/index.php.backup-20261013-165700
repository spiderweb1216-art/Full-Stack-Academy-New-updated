function normalizeQuizQuestions(mixed $value): array
{
    $out=[];
    foreach (array_slice(jsonArray($value),0,100) as $index=>$q) {
        if(!is_array($q)) continue;
        $question=clean($q['question']??'',1000);
        if($question==='') continue;
        $type=in_array($q['type']??'mcq',['mcq','true_false'],true)?$q['type']:'mcq';
        $options=$type==='true_false'?['True','False']:normalizeTextList($q['options']??[],10,300);
        if($type==='mcq' && count($options)<2) continue;
        $correct=max(0,min(count($options)-1,(int)($q['correct']??0)));
        $out[]=[
            'id'=>clean($q['id']??('q'.($index+1)),40) ?: 'q'.($index+1),
            'question'=>$question,
            'type'=>$type,
            'options'=>$options,
            'correct'=>$correct,
            'points'=>max(1,min(100,(int)($q['points']??1))),
        ];
    }
    return $out;
}

