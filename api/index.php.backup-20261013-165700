function normalizeTheme(array $input, array $base = []): array
{
    $theme = array_replace(themeDefaults(), $base);
    foreach (themeDefaults() as $key=>$fallback) {
        $value = trim((string)($input[$key] ?? $theme[$key] ?? $fallback));
        if ($key === 'radius') {
            if (!preg_match('/^\\d{1,2}(?:\\.\\d+)?(?:px|rem)$/',$value)) $value = $theme[$key] ?? $fallback;
        } elseif (!preg_match('/^#[0-9a-fA-F]{6}$/',$value)) {
            $value = $theme[$key] ?? $fallback;
        }
        $theme[$key] = $value;
    }
    return $theme;
}

