function base64UrlEncode(string $value): string
{
    return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
}

function zoomMeetingSdkJwt(PDO $pdo, string $meetingId, int $role): array
{
    $zoom=zoomSettings($pdo);
    $clientId=trim((string)($zoom['sdk_client_id']??''));
    $secret=decryptSecret((string)($zoom['sdk_client_secret_encrypted']??''),appKey());
    if($clientId==='' || $secret==='') throw new RuntimeException('Meeting SDK credentials are incomplete. Save the Meeting SDK Client ID and Client Secret in Admin → Zoom Live.');
    $meetingId=preg_replace('/\D+/','',$meetingId)??'';
    if($meetingId==='') throw new RuntimeException('This live class does not have a valid Zoom Meeting ID.');
    $iat=time()-30;
    $exp=$iat+7200;
    $header=['alg'=>'HS256','typ'=>'JWT'];
    $payload=[
        'appKey'=>$clientId,
        'sdkKey'=>$clientId,
        'mn'=>$meetingId,
        'role'=>$role===1?1:0,
        'iat'=>$iat,
        'exp'=>$exp,
        'tokenExp'=>$exp,
        'video_webrtc_mode'=>1,
    ];
    $h=base64UrlEncode((string)json_encode($header,JSON_UNESCAPED_SLASHES));
    $p=base64UrlEncode((string)json_encode($payload,JSON_UNESCAPED_SLASHES));
    $sig=base64UrlEncode(hash_hmac('sha256',$h.'.'.$p,$secret,true));
    return ['client_id'=>$clientId,'signature'=>$h.'.'.$p.'.'.$sig,'expires_at'=>$exp];
}

function zoomHostZak(PDO $pdo): string
{
    $zoom=zoomSettings($pdo);
    $host=trim((string)($zoom['host_user']??''));
    if($host==='') throw new RuntimeException('Default Zoom host user/email is missing.');
    try{
        $result=zoomApiRequest($pdo,'GET','users/'.rawurlencode($host).'/token?type=zak&ttl=7200');
    }catch(Throwable $error){
        $safe=preg_replace('/(Bearer\s+)[A-Za-z0-9._-]+/i','$1[hidden]',$error->getMessage());
        throw new RuntimeException('Zoom host authentication failed. Confirm the default host email is the same Zoom user that owns/hosts the meeting, add Server-to-Server OAuth scope user:read:token:admin, reactivate the app, then try again. Zoom response: '.$safe);
    }
    $token=trim((string)($result['token']??''));
    if($token==='') throw new RuntimeException('Zoom returned an empty host ZAK token.');
    return $token;
}

