function profileSlug(string $name, int $suffix = 0): string
{
    $slug = strtolower(trim((string)preg_replace('/[^a-z0-9]+/i', '-', $name), '-')) ?: 'member';
    return substr($slug . ($suffix > 0 ? '-' . $suffix : ''), 0, 190);
}

function generateStudentCode(PDO $pdo): string
{
    // Format requested by the academy: FSA_51026-AB7Q (day + month + 2-digit year + 4 random characters).
    $datePart = date('j') . date('n') . date('y');
    $alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    do {
        $suffix='';
        for($i=0;$i<4;$i++) $suffix .= $alphabet[random_int(0, strlen($alphabet)-1)];
        $code='FSA_'.$datePart.'-'.$suffix;
        $exists=$pdo->prepare('SELECT 1 FROM users WHERE student_code=? LIMIT 1');$exists->execute([$code]);
    } while ($exists->fetchColumn());
    return $code;
}

