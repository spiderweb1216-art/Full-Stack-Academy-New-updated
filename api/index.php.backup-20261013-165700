function ensureRecordingFromLiveSession(PDO $pdo, int $liveId): ?int
{
    $stmt=$pdo->prepare("SELECT l.*,c.title AS course_title FROM live_sessions l JOIN courses c ON c.id=l.course_id WHERE l.id=? LIMIT 1");
    $stmt->execute([$liveId]);
    $live=$stmt->fetch();
    if(!$live)return null;
    $url=trim((string)($live['recording_url']??''));
    $status=$url!==''?'published':'processing';
    $recordedAt=(string)($live['ends_at']??'');
    if($recordedAt==='')$recordedAt=date('Y-m-d H:i:s');
    $title=trim((string)($live['title']??''));
    if($title==='')$title=(string)($live['course_title']??'Recorded Class');
    $description=trim((string)($live['description']??''));
    if($description==='')$description='Recorded Live class for '.(string)($live['course_title']??'this course').'.';
    $insert=$pdo->prepare("INSERT INTO course_recordings (course_id,instructor_id,live_session_id,title,description,recording_url,source,status,recorded_at)
        VALUES (?,?,?,?,?,?, 'zoom', ?, ?)
        ON DUPLICATE KEY UPDATE title=VALUES(title),description=VALUES(description),recording_url=IF(VALUES(recording_url)<>'',VALUES(recording_url),recording_url),status=IF(VALUES(recording_url)<>'','published',status),recorded_at=VALUES(recorded_at)");
    $insert->execute([(int)$live['course_id'],(int)$live['instructor_id'],$liveId,$title,$description,$url,$status,$recordedAt]);
    $id=(int)$pdo->lastInsertId();
    if($id<1){$q=$pdo->prepare('SELECT id FROM course_recordings WHERE live_session_id=? LIMIT 1');$q->execute([$liveId]);$id=(int)($q->fetchColumn()?:0);}
    return $id>0?$id:null;
}

function zoomRecordingUrlForMeeting(PDO $pdo, string $meetingId): string
{
    $meetingId=preg_replace('/\\D+/','',$meetingId)??'';
    if($meetingId==='')return '';
    try{
        $result=zoomApiRequest($pdo,'GET','meetings/'.rawurlencode($meetingId).'/recordings');
    }catch(Throwable $e){
        // Recording may still be processing, unavailable on the current Zoom plan,
        // or the OAuth app may not have a recording-read scope. Manual URLs remain available.
        return '';
    }
    $files=is_array($result['recording_files']??null)?$result['recording_files']:[];
    // Prefer Zoom's browser play_url so the LMS can load the recording in its
    // YouTube-style player. Prefer completed MP4 video files when available.
    usort($files,static function($a,$b){
        $score=static function($f){
            if(!is_array($f))return 0;
            $s=0;
            if(strtoupper((string)($f['file_type']??''))==='MP4')$s+=20;
            if(strtolower((string)($f['status']??''))==='completed')$s+=10;
            if(!empty($f['play_url']))$s+=5;
            return $s;
        };
        return $score($b)<=>$score($a);
    });
    foreach($files as $file){
        if(!is_array($file))continue;
        $url=trim((string)($file['play_url']??''));
        if($url!=='')return $url;
    }
    $share=trim((string)($result['share_url']??''));
    if($share!=='')return $share;
    foreach($files as $file){
        if(!is_array($file))continue;
        $url=trim((string)($file['download_url']??''));
        if($url!=='')return $url;
    }
    return '';
}

function syncLiveRecording(PDO $pdo, int $liveId, int $instructorId=0): array
{
    $sql="SELECT * FROM live_sessions WHERE id=?".($instructorId>0?' AND instructor_id=?':'')." LIMIT 1";
    $stmt=$pdo->prepare($sql);$params=[$liveId];if($instructorId>0)$params[]=$instructorId;$stmt->execute($params);
    $live=$stmt->fetch();
    if(!$live)return ['synced'=>false,'message'=>'Live class not found.'];
    ensureRecordingFromLiveSession($pdo,$liveId);
    $existing=trim((string)($live['recording_url']??''));
    if($existing!=='')return ['synced'=>true,'url'=>$existing,'message'=>'Recording already available.'];
    $url=zoomRecordingUrlForMeeting($pdo,(string)($live['meeting_id']??''));
    if($url==='')return ['synced'=>false,'message'=>'Zoom recording is still processing or Cloud Recording is unavailable. You can add the recording URL manually.'];
    $pdo->prepare("UPDATE live_sessions SET recording_url=? WHERE id=?")->execute([$url,$liveId]);
    $pdo->prepare("UPDATE course_recordings SET recording_url=?,status='published',source='zoom',updated_at=NOW() WHERE live_session_id=?")->execute([$url,$liveId]);
    return ['synced'=>true,'url'=>$url,'message'=>'Zoom recording synced successfully.'];
}

function syncPendingInstructorRecordings(PDO $pdo, int $instructorId, int $limit=6): array
{
    $limit=max(1,min(12,$limit));
    $stmt=$pdo->prepare("SELECT l.id FROM live_sessions l LEFT JOIN course_recordings r ON r.live_session_id=l.id WHERE l.instructor_id=? AND l.status='ended' AND (COALESCE(l.recording_url,'')='' OR r.status='processing') ORDER BY l.ends_at DESC,l.id DESC LIMIT {$limit}");
    $stmt->execute([$instructorId]);
    $synced=0;$pending=0;
    foreach($stmt->fetchAll(PDO::FETCH_COLUMN) as $liveId){
        $result=syncLiveRecording($pdo,(int)$liveId,$instructorId);
        if(!empty($result['synced']))$synced++;else$pending++;
    }
    return ['synced'=>$synced,'pending'=>$pending];
}

function normalizeLiveSessionStatuses(PDO $pdo, ?int $instructorId=null): void
{
    $suffix=$instructorId!==null?' AND instructor_id=?':'';
    $params=$instructorId!==null?[$instructorId]:[];

    // A meeting far in the future must never remain marked live because of an
    // earlier test/start click.
    $stmt=$pdo->prepare(
        "UPDATE live_sessions
         SET status='scheduled'
         WHERE status='live'
           AND starts_at IS NOT NULL
           AND starts_at > DATE_ADD(NOW(), INTERVAL 15 MINUTE)"
         .$suffix
    );
    $stmt->execute($params);

    // Expired live/scheduled rows become history automatically.
    $stmt=$pdo->prepare(
        "UPDATE live_sessions
         SET status='ended'
         WHERE status IN ('live','scheduled')
           AND (
             (ends_at IS NOT NULL AND ends_at < NOW())
             OR
             (ends_at IS NULL AND starts_at IS NOT NULL AND starts_at < DATE_SUB(NOW(), INTERVAL 3 HOUR))
           )"
         .$suffix
    );
    $stmt->execute($params);
}

