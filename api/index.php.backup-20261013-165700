function normalizeCourseModeContent(mixed $value): array
{
    $value = is_array($value) ? $value : [];
    $projects = normalizeProjects($value['projectItems'] ?? []);
    $reviews = normalizeCourseReviews($value['courseReviews'] ?? []);
    $projectsCount = $projects ? count($projects) : max(0,(int)($value['projects'] ?? 0));
    $reviewsCount = $reviews ? max(count($reviews),(int)($value['reviews'] ?? 0)) : max(0,(int)($value['reviews'] ?? 0));
    $rating = max(0,min(5,(float)($value['rating'] ?? 0)));
    if($rating<=0 && $reviews) $rating=array_sum(array_column($reviews,'rating'))/count($reviews);
    return [
        'badge'=>clean($value['badge'] ?? '',60),
        'image'=>clean($value['image'] ?? '',2000),
        'short'=>clean($value['short'] ?? '',2000),
        'contentHeading'=>clean($value['contentHeading'] ?? $value['content_heading'] ?? '',190),
        'description'=>clean($value['description'] ?? '',20000),
        'price'=>(float)($value['price'] ?? 0),
        'originalPrice'=>(float)($value['originalPrice'] ?? 0),
        'duration'=>clean($value['duration'] ?? '',80),
        'hours'=>max(0,(int)($value['hours'] ?? 0)),
        'projects'=>$projectsCount,
        'rating'=>$rating,
        'reviews'=>$reviewsCount,
        'students'=>max(0,(int)($value['students'] ?? 0)),
        'level'=>clean($value['level'] ?? '',100),
        'language'=>clean($value['language'] ?? '',100),
        'updated'=>clean($value['updated'] ?? '',80),
        'instructor'=>clean($value['instructor'] ?? '',150),
        'instructorRole'=>clean($value['instructorRole'] ?? '',180),
        'skills'=>normalizeTextList($value['skills'] ?? [],100,500),
        'requirements'=>normalizeTextList($value['requirements'] ?? [],100,500),
        'audience'=>normalizeTextList($value['audience'] ?? [],100,500),
        'projectItems'=>$projects,
        'courseReviews'=>$reviews,
    ];
}

function courseModeContentsFromRow(array $row): array
{
    $legacy = legacyCourseModeContent($row);
    $stored = jsonArray($row['mode_contents_json'] ?? '[]');
    $out = [];
    foreach(['offline','live','recorded'] as $mode){
        if(isset($stored[$mode]) && is_array($stored[$mode])) $out[$mode]=normalizeCourseModeContent($stored[$mode]);
        else $out[$mode]=$mode==='offline'?normalizeCourseModeContent($legacy):normalizeCourseModeContent([]);
    }
    return $out;
}

function ensureCourseContentColumns(PDO $pdo): void
{
    $columns = [
        'projects_json' => 'LONGTEXT NULL AFTER `modules_json`',
        'course_reviews_json' => 'LONGTEXT NULL AFTER `projects_json`',
        'delivery_mode' => "ENUM('offline','live','recorded') NOT NULL DEFAULT 'offline' AFTER `course_reviews_json`",
        'delivery_modes_json' => 'LONGTEXT NULL AFTER `delivery_mode`',
        'mode_contents_json' => 'LONGTEXT NULL AFTER `delivery_modes_json`',
        'pending_mode_content_json' => 'LONGTEXT NULL AFTER `mode_contents_json`',
        'branch_name' => "VARCHAR(120) NOT NULL DEFAULT ''",
        'pending_modules_json' => 'LONGTEXT NULL AFTER `modules_json`',
        'pending_lessons_count' => 'INT UNSIGNED NOT NULL DEFAULT 0 AFTER `pending_modules_json`',
        'approval_status' => "ENUM('approved','pending','rejected') NOT NULL DEFAULT 'approved' AFTER `pending_lessons_count`",
        'approval_kind' => "ENUM('none','branch','central') NOT NULL DEFAULT 'none' AFTER `approval_status`",
        'approval_note' => "TEXT NULL AFTER `approval_kind`",
        'submitted_by' => 'BIGINT UNSIGNED NULL AFTER `approval_note`',
        'reviewed_by' => 'BIGINT UNSIGNED NULL AFTER `submitted_by`',
        'reviewed_at' => 'DATETIME NULL AFTER `reviewed_by`',
    ];
    $check = $pdo->prepare("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='courses' AND COLUMN_NAME=?");
    foreach ($columns as $column => $definition) {
        $check->execute([$column]);
        if ((int)$check->fetchColumn() === 0) {
            $pdo->exec("ALTER TABLE `courses` ADD COLUMN `{$column}` {$definition}");
        }
    }
    $rows=$pdo->query("SELECT * FROM courses WHERE mode_contents_json IS NULL OR mode_contents_json='' OR delivery_modes_json IS NULL OR delivery_modes_json=''")->fetchAll();
    if($rows){
        $update=$pdo->prepare('UPDATE courses SET delivery_mode=?, delivery_modes_json=?, mode_contents_json=? WHERE id=?');
        foreach($rows as $row){
            $primary=in_array($row['delivery_mode'] ?? 'offline',['offline','live','recorded'],true)?$row['delivery_mode']:'offline';
            $storedModes=jsonArray($row['delivery_modes_json'] ?? '[]');
            $enabled=array_values(array_filter($storedModes,fn($m)=>in_array($m,['offline','live','recorded'],true)));
            if(!$enabled)$enabled=[$primary];
            $storedContents=jsonArray($row['mode_contents_json'] ?? '[]');
            $modes=[];
            foreach(['offline','live','recorded'] as $m){
                if(isset($storedContents[$m])&&is_array($storedContents[$m]))$modes[$m]=normalizeCourseModeContent($storedContents[$m]);
                else $modes[$m]=$m===$primary?normalizeCourseModeContent(legacyCourseModeContent($row)):normalizeCourseModeContent([]);
            }
            $update->execute([$enabled[0],json_encode($enabled,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),json_encode($modes,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),(int)$row['id']]);
        }
    }
}


