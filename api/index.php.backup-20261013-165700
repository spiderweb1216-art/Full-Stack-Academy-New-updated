function assertCanManageUser(PDO $pdo, array $actor, array $target): void
{
    if ((int)$actor['id'] === (int)$target['id']) return;
    $actorRole=adminRole($actor);$targetRole=adminRole($target);
    if ($actorRole==='super_admin') return;
    // Admin Staff cannot create instructors, but can centrally manage existing instructor
    // accounts so they can grant/revoke recorded-LMS authoring permission.
    if ($actorRole==='admin_staff' && $targetRole==='instructor') return;
    if (!roleCanCreateRole($actorRole,$targetRole)) respond(['success'=>false,'message'=>'You cannot manage this user role.'],403);
    if (in_array($actorRole,['branch_head','branch_admin'],true) && !sameBranch($pdo,cleanBranchName($actor),(string)($target['branch']??''))) {
