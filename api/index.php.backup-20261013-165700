function normalizeCmsRouteRule(mixed $value): string
{
    $route = trim((string)$value);
    if ($route === '' || $route === '*') return '*';
    if (!str_starts_with($route,'/')) $route = '/' . $route;
    $route = preg_replace('~/{2,}~','/',$route) ?: '/';
    if (!preg_match('~^/[A-Za-z0-9_./?&=:%+*\\-]*$~',$route)) return '';
    return clean($route,190);
}

