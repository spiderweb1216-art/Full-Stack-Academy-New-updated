function csrfToken(): string
{
    if (empty($_SESSION['csrf_token']) || !is_string($_SESSION['csrf_token'])) {
        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    }
    return $_SESSION['csrf_token'];
}

function requireCsrf(): void
{
    $provided = (string)($_SERVER['HTTP_X_CSRF_TOKEN'] ?? '');
    if ($provided === '' || !hash_equals(csrfToken(), $provided)) {
        respond(['success' => false, 'message' => 'Your security token expired. Refresh the page and try again.'], 419);
    }
}

function respond(array $payload, int $status = 200): never
{
    $payload['csrf_token'] ??= csrfToken();
    http_response_code($status);
    // Discard any accidental buffered warning/notice so fetch().json() always
    // receives JSON instead of a 200 response containing HTML diagnostics.
    if (ob_get_level() > 0 && ob_get_length() !== false) @ob_clean();
    $json = json_encode(
        $payload,
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE | JSON_PARTIAL_OUTPUT_ON_ERROR
    );
    if ($json === false || $json === '') {
        http_response_code(500);
        $json = '{"success":false,"message":"The backend could not encode its response. Check the PHP error log."}';
    }
    echo $json;
    exit;
}

function input(): array
{
    $type = strtolower((string)($_SERVER['CONTENT_TYPE'] ?? ''));
    if (str_contains($type, 'application/json')) {
        $decoded = json_decode((string)file_get_contents('php://input'), true);
        return is_array($decoded) ? $decoded : [];
    }
    return $_POST;
}

function clean(mixed $value, int $max = 500): string
{
    $value = trim((string)$value);
    return function_exists('mb_substr') ? mb_substr($value, 0, $max) : substr($value, 0, $max);
}

function nowSql(): string { return date('Y-m-d H:i:s'); }
function iso(?string $value): ?string { return $value ? date('c', strtotime($value)) : null; }
function boolValue(mixed $value): bool { return filter_var($value, FILTER_VALIDATE_BOOLEAN); }
function jsonArray(mixed $value): array
{
    if (is_array($value)) return $value;
    $decoded = json_decode((string)$value, true);
    return is_array($decoded) ? $decoded : [];
}


function normalizeTextList(mixed $value, int $maxItems = 100, int $maxLength = 500): array
{
    $items = jsonArray($value);
    $cleaned = [];
    foreach (array_slice($items, 0, $maxItems) as $item) {
        $text = clean(is_scalar($item) ? $item : '', $maxLength);
        if ($text !== '') $cleaned[] = $text;
    }
    return $cleaned;
}

function normalizeHttpUrl(mixed $value, int $max = 2000): string
{
    $url = trim(html_entity_decode((string)$value, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($url === '') return '';
    if (str_starts_with($url, '//')) $url = 'https:' . $url;
    if (preg_match('/^(?:uploads\/|assets\/)/i', $url)) return clean($url, $max);
    $parts = parse_url($url);
    if (!is_array($parts) || !in_array(strtolower((string)($parts['scheme'] ?? '')), ['http','https'], true) || empty($parts['host'])) return '';
    return clean($url, $max);
}

function normalizeEmbedUrl(mixed $value): string
{
    $raw = trim((string)$value);
    if ($raw === '') return '';
    if (preg_match("~<iframe\\b[^>]*\\bsrc\\s*=\\s*([\"'])(.*?)\\1~is", $raw, $match)) {
        $raw = $match[2];
    }
    $url = normalizeHttpUrl($raw, 2500);
    return str_starts_with(strtolower($url), 'https://') ? $url : '';
}

function normalizeLessonResources(mixed $value): array
{
    $resources = [];
    foreach (array_slice(jsonArray($value), 0, 30) as $resource) {
        if (!is_array($resource)) continue;
        $title = clean($resource['title'] ?? '', 190);
        $url = normalizeHttpUrl($resource['url'] ?? '', 2500);
        if ($url === '') continue;
        $resources[] = ['title' => $title !== '' ? $title : 'Lesson resource', 'url' => $url];
    }
    return $resources;
}

function normalizeCourseContentBlocks(mixed $value): array
{
    $blocks = [];
    foreach (array_slice(jsonArray($value), 0, 120) as $block) {
        if (!is_array($block)) continue;
        $type = in_array(($block['type'] ?? 'text'), ['text','image','video','file','link'], true) ? $block['type'] : 'text';
        $title = clean($block['title'] ?? '', 190);
        $text = clean($block['text'] ?? $block['description'] ?? '', 30000);
        $url = $type === 'video' ? normalizeEmbedUrl($block['url'] ?? '') : normalizeHttpUrl($block['url'] ?? '', 3000);
        if ($type === 'text' && $title === '' && $text === '') continue;
        if ($type !== 'text' && $title === '' && $text === '' && $url === '') continue;
        $blocks[] = ['type'=>$type,'title'=>$title,'text'=>$text,'url'=>$url];
    }
    return $blocks;
}

function normalizeLessonVideos(mixed $value, array $legacyLesson = []): array
{
    $rawVideos = jsonArray($value);
    if (!$rawVideos) {
        $legacyProvider = in_array($legacyLesson['videoProvider'] ?? 'none', ['none','bunny','embed'], true) ? $legacyLesson['videoProvider'] : 'none';
        $legacyVideoId = preg_replace('/[^a-zA-Z0-9_-]+/', '', clean($legacyLesson['videoId'] ?? '', 120));
        $legacyEmbed = normalizeEmbedUrl($legacyLesson['embedUrl'] ?? '');
        if (($legacyProvider === 'bunny' && $legacyVideoId !== '') || ($legacyProvider === 'embed' && $legacyEmbed !== '')) {
            $rawVideos[] = [
                'title' => clean($legacyLesson['title'] ?? 'Lecture 01', 190),
                'duration' => clean($legacyLesson['duration'] ?? '', 60),
                'videoProvider' => $legacyProvider,
                'videoId' => $legacyVideoId,
                'embedUrl' => $legacyEmbed,
                'content' => '',
                'image' => '',
            ];
        }
    }

    $videos = [];
    foreach (array_slice($rawVideos, 0, 100) as $index => $video) {
        if (!is_array($video)) continue;
        $provider = in_array($video['videoProvider'] ?? 'none', ['none','bunny','embed'], true) ? $video['videoProvider'] : 'none';
        $videoId = preg_replace('/[^a-zA-Z0-9_-]+/', '', clean($video['videoId'] ?? '', 120));
        $embedUrl = normalizeEmbedUrl($video['embedUrl'] ?? '');
        if ($provider === 'bunny' && $videoId === '') $provider = 'none';
        if ($provider === 'embed' && $embedUrl === '') $provider = 'none';
        $title = clean($video['title'] ?? '', 190);
        $content = clean($video['content'] ?? '', 30000);
        $image = normalizeHttpUrl($video['image'] ?? '', 2000);
        if ($title === '' && $provider === 'none' && $content === '' && $image === '') continue;
        $videos[] = [
            'title' => $title !== '' ? $title : 'Lecture ' . str_pad((string)($index + 1), 2, '0', STR_PAD_LEFT),
            'duration' => clean($video['duration'] ?? '', 60),
            'videoProvider' => $provider,
            'videoId' => $provider === 'bunny' ? $videoId : '',
            'embedUrl' => $provider === 'embed' ? $embedUrl : '',
            'content' => $content,
            'image' => $image,
        ];
    }
    return $videos;
}

function normalizeModules(mixed $value): array
{
    $modules = [];
    foreach (array_slice(jsonArray($value), 0, 100) as $moduleIndex => $module) {
        if (!is_array($module)) continue;
        $lessons = [];
        foreach (array_slice(jsonArray($module['lessons'] ?? []), 0, 300) as $lesson) {
            if (!is_array($lesson)) continue;
            $title = clean($lesson['title'] ?? '', 190);
            if ($title === '') continue;
            $videos = normalizeLessonVideos($lesson['videos'] ?? [], $lesson);
            $lessons[] = [
                'title' => $title,
                'duration' => clean($lesson['duration'] ?? '', 60),
                'preview' => boolValue($lesson['preview'] ?? false),
                'content' => clean($lesson['content'] ?? '', 30000),
                'image' => normalizeHttpUrl($lesson['image'] ?? '', 2000),
                'pdfUrl' => normalizeHttpUrl($lesson['pdfUrl'] ?? $lesson['pdf_url'] ?? '', 2500),
                'resources' => normalizeLessonResources($lesson['resources'] ?? []),
                'videos' => $videos,
            ];
        }
        $title = clean($module['title'] ?? '', 190);
        if ($title === '' && $lessons) $title = 'Module ' . ($moduleIndex + 1);
        if ($title === '' && !$lessons) continue;
        $modules[] = [
            'title' => $title,
            'duration' => clean($module['duration'] ?? '', 60),
            'description' => clean($module['description'] ?? '', 12000),
            'points' => normalizeTextList($module['points'] ?? [], 80, 500),
            'contentBlocks' => normalizeCourseContentBlocks($module['contentBlocks'] ?? $module['content_blocks'] ?? []),
            'lessons' => $lessons,
        ];
    }
    return $modules;
}

function publicModules(array $modules): array
{
    return array_map(static function(array $module): array {
        return [
            'title' => clean($module['title'] ?? '', 190),
            'duration' => clean($module['duration'] ?? '', 60),
            'lessons' => array_map(static function(array $lesson): array {
                $videos = normalizeLessonVideos($lesson['videos'] ?? [], $lesson);
                return [
                    'title' => clean($lesson['title'] ?? '', 190),
                    'duration' => clean($lesson['duration'] ?? '', 60),
                    'preview' => boolValue($lesson['preview'] ?? false),
                    'lectureCount' => count($videos),
                ];
            }, array_values(array_filter(jsonArray($module['lessons'] ?? []), 'is_array'))),
        ];
    }, array_values(array_filter($modules, 'is_array')));
}

function normalizeProjects(mixed $value): array
{
    $projects = [];
    foreach (array_slice(jsonArray($value), 0, 100) as $index => $project) {
        if (!is_array($project)) continue;
        $title = clean($project['title'] ?? '', 190);
        $description = clean($project['description'] ?? '', 4000);
        if ($title === '' && $description !== '') $title = 'Project ' . ($index + 1);
        if ($title === '' && $description === '') continue;
        $projects[] = ['title' => $title, 'description' => $description];
    }
    return $projects;
}

function normalizeCourseReviews(mixed $value): array
{
    $reviews = [];
    foreach (array_slice(jsonArray($value), 0, 200) as $review) {
        if (!is_array($review)) continue;
        $name = clean($review['name'] ?? '', 120);
        $text = clean($review['text'] ?? '', 3000);
        if ($name === '' && $text === '') continue;
        $rating = max(1, min(5, (int)($review['rating'] ?? 5)));
        $reviews[] = [
            'name' => $name !== '' ? $name : 'Student',
            'role' => clean($review['role'] ?? '', 160),
            'rating' => $rating,
            'text' => $text,
        ];
    }
    return $reviews;
}

