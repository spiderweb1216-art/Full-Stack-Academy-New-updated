function ensureBatchFeatures(PDO $pdo): void
{
    $pdo->exec("CREATE TABLE IF NOT EXISTS batches (
        id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
        course_id BIGINT UNSIGNED NULL,
        course_name VARCHAR(190) NOT NULL,
        course_slug VARCHAR(190) NOT NULL DEFAULT '',
        image TEXT NULL,
        branch_slug VARCHAR(120) NOT NULL DEFAULT 'online',
        branch_name VARCHAR(120) NOT NULL DEFAULT 'Online',
        instructor_id BIGINT UNSIGNED NULL,
        instructor_name VARCHAR(120) NOT NULL DEFAULT '',
        mode ENUM('live-streamed','recorded','offline-classroom') NOT NULL DEFAULT 'live-streamed',
        shift ENUM('morning','afternoon','evening','anytime') NOT NULL DEFAULT 'morning',
        start_date DATE NULL,
        end_date DATE NULL,
        start_label VARCHAR(80) NOT NULL DEFAULT '',
        time_label VARCHAR(120) NOT NULL DEFAULT '',
        days_label VARCHAR(120) NOT NULL DEFAULT '',
        seats_total INT UNSIGNED NULL,
        seats_available INT UNSIGNED NULL,
        fee DECIMAL(12,2) NOT NULL DEFAULT 0,
        classroom VARCHAR(190) NOT NULL DEFAULT '',
        meeting_url TEXT NULL,
        description TEXT NULL,
        status ENUM('published','draft','closed') NOT NULL DEFAULT 'published',
        sort_order INT NOT NULL DEFAULT 0,
        created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
        updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
        INDEX idx_batches_public (status,sort_order,start_date),
        INDEX idx_batches_branch (branch_slug,status),
        INDEX idx_batches_course (course_slug,status),
        CONSTRAINT fk_batches_course FOREIGN KEY (course_id) REFERENCES courses(id) ON DELETE SET NULL,
        CONSTRAINT fk_batches_instructor FOREIGN KEY (instructor_id) REFERENCES users(id) ON DELETE SET NULL
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");

    $imageColumn=$pdo->query("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='batches' AND COLUMN_NAME='image'")->fetchColumn();
    if ((int)$imageColumn === 0) $pdo->exec("ALTER TABLE batches ADD COLUMN image TEXT NULL AFTER course_slug");

    $pdo->exec("CREATE TABLE IF NOT EXISTS app_migrations (
        migration_key VARCHAR(120) PRIMARY KEY,
        applied_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
    $seedKey='demo-batches-v1';
    $check=$pdo->prepare('SELECT 1 FROM app_migrations WHERE migration_key=? LIMIT 1');
    $check->execute([$seedKey]);
    if ($check->fetchColumn()) return;

    $courses=$pdo->query("SELECT id,title,slug,price,image FROM courses WHERE status='published' ORDER BY featured DESC,id ASC LIMIT 8")->fetchAll();
    if (!$courses) {
        $courses=[
            ['id'=>null,'title'=>'Full Stack Development','slug'=>'full-stack-development','price'=>0,'image'=>'assets/images/course-v16/tech-trek.svg'],
            ['id'=>null,'title'=>'Data Science & AI','slug'=>'data-science-ai','price'=>0,'image'=>'assets/images/course-v16/ai-machine-learning.svg'],
            ['id'=>null,'title'=>'Cloud & DevOps','slug'=>'cloud-devops','price'=>0,'image'=>'assets/images/course-v16/azure-data-engineer.svg'],
            ['id'=>null,'title'=>'Software Testing','slug'=>'software-testing','price'=>0,'image'=>'assets/images/course-v16/software-testing.svg'],
        ];
    }
    $branches=$pdo->query("SELECT slug,short_name,name FROM branches WHERE status='published' ORDER BY sort_order,id")->fetchAll();
    if (!$branches) $branches=[['slug'=>'ameerpet','short_name'=>'Ameerpet','name'=>'FSA — Ameerpet']];
    $instructorRows=$pdo->query("SELECT id,name,branch FROM users WHERE role='instructor' AND status='active' ORDER BY id ASC")->fetchAll();
    $instructorsByBranch=[];
    foreach($instructorRows as $inst){$instructorsByBranch[strtolower(trim((string)$inst['branch']))][]=$inst;}

    $insert=$pdo->prepare("INSERT INTO batches
      (course_id,course_name,course_slug,image,branch_slug,branch_name,instructor_id,instructor_name,mode,shift,start_date,end_date,start_label,time_label,days_label,seats_total,seats_available,fee,classroom,meeting_url,description,status,sort_order)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
    $today=new DateTimeImmutable('today');
    $sort=1;
    foreach($branches as $bi=>$branch){
        $short=trim((string)($branch['short_name'] ?: preg_replace('/^FSA\s*[—-]\s*/u','',(string)$branch['name'])));
        $key=strtolower($short);
        $instList=$instructorsByBranch[$key] ?? [];
        for($j=0;$j<2;$j++){
            $course=$courses[($bi*2+$j)%count($courses)];
            $inst=$instList ? $instList[$j%count($instList)] : null;
            $start=$today->modify('+' . (7 + ($bi*4) + ($j*3)) . ' days');
            $shift=$j%2===0?'morning':'evening';
            $time=$shift==='morning'?'10:00 AM – 11:30 AM':'05:30 PM – 07:00 PM';
            $insert->execute([
                $course['id'] ?: null,$course['title'],$course['slug'],$course['image']??'',$branch['slug'],$short,
                $inst['id'] ?? null,$inst['name'] ?? 'FSA Faculty','offline-classroom',$shift,$start->format('Y-m-d'),$start->modify('+8 weeks')->format('Y-m-d'),'',$time,'Mon · Wed · Fri',30,24-($bi+$j),$course['price'] ?? 0,
                $short . ' Classroom ' . ($j+1),'','Instructor-led classroom batch at the ' . $short . ' branch.','published',$sort++
            ]);
        }
    }
    // Scheduled online batches.
    for($j=0;$j<3;$j++){
        $course=$courses[$j%count($courses)];
        $inst=$instructorRows ? $instructorRows[$j%count($instructorRows)] : null;
        $start=$today->modify('+' . (5+$j*5) . ' days');
        $shift=['morning','afternoon','evening'][$j%3];
        $time=['08:00 AM – 09:30 AM','01:00 PM – 02:30 PM','07:30 PM – 09:00 PM'][$j%3];
        $insert->execute([$course['id']?:null,$course['title'],$course['slug'],$course['image']??'','online','Online',$inst['id']??null,$inst['name']??'FSA Faculty','live-streamed',$shift,$start->format('Y-m-d'),$start->modify('+8 weeks')->format('Y-m-d'),'',$time,'Tue · Thu · Sat',40,32-$j*3,$course['price']??0,'','https://zoom.us/','Live instructor-led online batch.','published',$sort++]);
    }
    // Recorded options are also backend records, not frontend-generated rows.
    for($j=0;$j<min(4,count($courses));$j++){
