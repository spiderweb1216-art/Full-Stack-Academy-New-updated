function logEmail(PDO $pdo, string $to, string $subject, string $type, string $status, string $message): void
{
    $stmt = $pdo->prepare('INSERT INTO email_logs (recipient,subject,email_type,status,message) VALUES (?,?,?,?,?)');
    $stmt->execute([$to, $subject, $type, $status, $message]);
