function ensureCourseBatchCoverage(PDO $pdo): void
{
    // Link legacy rows to their course first so every public batch has a stable FK.
    try {
        $pdo->exec("UPDATE batches b JOIN courses c ON (b.course_id IS NULL OR b.course_id=0) AND b.course_slug=c.slug SET b.course_id=c.id WHERE c.id IS NOT NULL");
    } catch (Throwable $error) {
        // Older MySQL variants may reject the update in unusual configurations; the
        // insert coverage below still keeps new rows correctly linked.
    }

    $courses=$pdo->query("SELECT * FROM courses WHERE status='published' AND visibility='public' ORDER BY featured DESC,id ASC")->fetchAll();
    if (!$courses) return;

    $branches=$pdo->query("SELECT slug,short_name,name FROM branches WHERE status='published' ORDER BY sort_order ASC,id ASC")->fetchAll();
    if (!$branches) $branches=[['slug'=>'ameerpet','short_name'=>'Ameerpet','name'=>'FSA — Ameerpet']];
    $instructors=$pdo->query("SELECT id,name,branch FROM users WHERE role='instructor' AND status='active' ORDER BY id ASC")->fetchAll();

    $exists=$pdo->prepare("SELECT id FROM batches WHERE course_id=? AND mode=? LIMIT 1");
    $insert=$pdo->prepare("INSERT INTO batches
      (course_id,course_name,course_slug,image,branch_slug,branch_name,instructor_id,instructor_name,mode,shift,start_date,end_date,start_label,time_label,days_label,seats_total,seats_available,fee,classroom,meeting_url,description,status,sort_order)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
    $sort=(int)($pdo->query("SELECT COALESCE(MAX(sort_order),0) FROM batches")->fetchColumn() ?: 0) + 1;
    $today=new DateTimeImmutable('today');

    foreach($courses as $index=>$course){
        $enabled=jsonArray($course['delivery_modes_json'] ?? '[]');
        $enabled=array_values(array_filter($enabled,fn($m)=>in_array($m,['offline','live','recorded'],true)));
        if(!$enabled){
            $primary=in_array($course['delivery_mode'] ?? 'offline',['offline','live','recorded'],true)?$course['delivery_mode']:'offline';
            $enabled=[$primary];
        }
        $contents=courseModeContentsFromRow($course);
        foreach($enabled as $mode){
            $batchMode=$mode==='offline'?'offline-classroom':($mode==='recorded'?'recorded':'live-streamed');
            $exists->execute([(int)$course['id'],$batchMode]);
            if($exists->fetchColumn()) continue;

            $content=$contents[$mode] ?? normalizeCourseModeContent([]);
            $fee=(float)($content['price'] ?? 0);
            $image=(string)($content['image'] ?? '');
            $inst=$instructors ? $instructors[$index % count($instructors)] : null;
            $instructorId=$inst['id'] ?? null;
            $instructorName=$inst['name'] ?? 'FSA Faculty';

            if($mode==='recorded'){
                $insert->execute([(int)$course['id'],$course['title'],$course['slug'],$image,'online','Online',$instructorId,$instructorName,'recorded','anytime',null,null,'Start Anytime','Self-paced access','Start anytime',null,null,$fee,'','','Recorded LMS access for this course with flexible start.','published',$sort++]);
                continue;
            }

            $dayOffset=5 + (($index * 3 + ($mode==='offline'?2:0)) % 24);
            $start=$today->modify('+' . $dayOffset . ' days');
            $end=$start->modify('+8 weeks');
            $shift=['morning','afternoon','evening'][$index%3];
            $time=['10:00 AM – 11:30 AM','01:00 PM – 02:30 PM','06:30 PM – 08:00 PM'][$index%3];

            if($mode==='offline'){
                $branch=$branches[$index % count($branches)];
                $short=trim((string)($branch['short_name'] ?: preg_replace('/^FSA\s*[—-]\s*/u','',(string)$branch['name'])));
                $insert->execute([(int)$course['id'],$course['title'],$course['slug'],$image,$branch['slug'],$short,$instructorId,$instructorName,'offline-classroom',$shift,$start->format('Y-m-d'),$end->format('Y-m-d'),'',$time,'Mon · Wed · Fri',30,24,$fee,$short . ' Classroom','','Instructor-led classroom batch for this course.','published',$sort++]);
            }else{
                $insert->execute([(int)$course['id'],$course['title'],$course['slug'],$image,'online','Online',$instructorId,$instructorName,'live-streamed',$shift,$start->format('Y-m-d'),$end->format('Y-m-d'),'',$time,'Tue · Thu · Sat',40,32,$fee,'','', 'Live instructor-led online batch for this course.','published',$sort++]);
            }
        }
    }
}

