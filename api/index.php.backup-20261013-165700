function issueRememberToken(PDO $pdo, int $userId): void
{
    try {
        $raw = bin2hex(random_bytes(32));
        $hash = hash('sha256', $raw);
        $pdo->prepare('DELETE FROM auth_tokens WHERE expires_at <= NOW() OR user_id=?')->execute([$userId]);
        $pdo->prepare('INSERT INTO auth_tokens (user_id,token_hash,expires_at,last_used_at) VALUES (?,?,DATE_ADD(NOW(),INTERVAL 30 DAY),NOW())')->execute([$userId,$hash]);
        setcookie('fsa_remember', $raw, rememberCookieOptions(time() + FSA_LOGIN_LIFETIME));
        $_COOKIE['fsa_remember'] = $raw;
    } catch (Throwable $error) {
        error_log('Persistent login token could not be created: ' . $error->getMessage());
    }
}

function clearRememberToken(PDO $pdo): void
{
    $raw = (string)($_COOKIE['fsa_remember'] ?? '');
    try {
        if ($raw !== '') {
            $pdo->prepare('DELETE FROM auth_tokens WHERE token_hash=?')->execute([hash('sha256', $raw)]);
        }
    } catch (Throwable $error) {
        error_log('Persistent login token could not be cleared: ' . $error->getMessage());
    }
    setcookie('fsa_remember', '', rememberCookieOptions(time() - 42000));
    unset($_COOKIE['fsa_remember']);
}

function rememberedUserId(PDO $pdo): int
{
    $raw = (string)($_COOKIE['fsa_remember'] ?? '');
    if (!preg_match('/^[a-f0-9]{64}$/', $raw)) return 0;
    try {
        $hash = hash('sha256', $raw);
        $stmt = $pdo->prepare("SELECT t.user_id FROM auth_tokens t JOIN users u ON u.id=t.user_id WHERE t.token_hash=? AND t.expires_at>NOW() AND u.status='active' AND u.role IN ('student','instructor') LIMIT 1");
        $stmt->execute([$hash]);
        $userId = (int)($stmt->fetchColumn() ?: 0);
        if ($userId > 0) {
            $pdo->prepare('UPDATE auth_tokens SET last_used_at=NOW(),expires_at=DATE_ADD(NOW(),INTERVAL 30 DAY) WHERE token_hash=?')->execute([$hash]);
            setcookie('fsa_remember', $raw, rememberCookieOptions(time() + FSA_LOGIN_LIFETIME));
            return $userId;
        }
        clearRememberToken($pdo);
    } catch (Throwable $error) {
        error_log('Persistent login token could not be read: ' . $error->getMessage());
    }
    return 0;
}

function currentUser(PDO $pdo): ?array
{
    $id = (int)($_SESSION['user_id'] ?? 0);
    if ($id < 1) {
        $id = rememberedUserId($pdo);
        if ($id > 0) {
            session_regenerate_id(true);
            $_SESSION['user_id'] = $id;
        }
    }
    if ($id < 1) return null;
    $stmt = $pdo->prepare("SELECT * FROM users WHERE id=? AND status='active' AND role IN ('student','instructor') LIMIT 1");
    $stmt->execute([$id]);
    $user = $stmt->fetch();
    if (!$user) {
        unset($_SESSION['user_id']);
        clearRememberToken($pdo);
        return null;
    }
    return $user;
}

function currentAdmin(PDO $pdo): ?array
{
    $id = (int)($_SESSION['admin_user_id'] ?? 0);

    // Backward compatibility: convert an administrator stored by an older version
    // in user_id into the new independent admin session without affecting a learner login.
    if ($id < 1 && !empty($_SESSION['user_id'])) {
        $legacyId = (int)$_SESSION['user_id'];
        $legacyStmt = $pdo->prepare("SELECT id FROM users WHERE id=? AND status='active' AND role IN ('admin','super_admin','admin_staff','branch_head','branch_admin','instructor') LIMIT 1");
        $legacyStmt->execute([$legacyId]);
        if ($legacyStmt->fetchColumn()) {
            $id = $legacyId;
            $_SESSION['admin_user_id'] = $legacyId;
            unset($_SESSION['user_id']);
        }
    }

    if ($id < 1) return null;
    $stmt = $pdo->prepare("SELECT * FROM users WHERE id=? AND status='active' AND role IN ('admin','super_admin','admin_staff','branch_head','branch_admin','instructor') LIMIT 1");
    $stmt->execute([$id]);
    $user = $stmt->fetch();
    if (!$user) {
        unset($_SESSION['admin_user_id']);
        return null;
    }
    return $user;
}

function currentRoleUser(PDO $pdo, string $role): ?array
{
    if (!in_array($role, ['student','instructor'], true)) return null;
    $sessionKey = $role === 'student' ? 'student_user_id' : 'instructor_user_id';
    $id = (int)($_SESSION[$sessionKey] ?? 0);

    // Backward compatibility: migrate the old shared learner session into the
    // role-specific slot without deleting the other profile session.
    if ($id < 1 && !empty($_SESSION['user_id'])) {
        $legacyId = (int)$_SESSION['user_id'];
        $legacyStmt = $pdo->prepare("SELECT id FROM users WHERE id=? AND status='active' AND role=? LIMIT 1");
        $legacyStmt->execute([$legacyId,$role]);
        if ($legacyStmt->fetchColumn()) {
            $id = $legacyId;
            $_SESSION[$sessionKey] = $legacyId;
        }
    }

    // Persistent login is still a single browser cookie. Only adopt it when it
    // belongs to the requested profile type.
    if ($id < 1) {
        $rememberedId = rememberedUserId($pdo);
        if ($rememberedId > 0) {
            $rememberStmt = $pdo->prepare("SELECT id FROM users WHERE id=? AND status='active' AND role=? LIMIT 1");
            $rememberStmt->execute([$rememberedId,$role]);
            if ($rememberStmt->fetchColumn()) {
                $id = $rememberedId;
                $_SESSION[$sessionKey] = $rememberedId;
            }
        }
    }

    if ($id < 1) return null;
    $stmt = $pdo->prepare("SELECT * FROM users WHERE id=? AND status='active' AND role=? LIMIT 1");
    $stmt->execute([$id,$role]);
    $user = $stmt->fetch();
    if (!$user) {
        unset($_SESSION[$sessionKey]);
        return null;
    }
    return $user;
}

